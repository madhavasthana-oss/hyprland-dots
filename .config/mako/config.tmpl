# ─────────────────────────────────────────────────────────────
#  Astral-Vagabond · mako
#  Rendered by hypr/hyprland/scripts/apply-theme-clients.sh
#  from quickshell/astral-vagabond/colors/active-colors.json
#
#  Edit this template (config.tmpl), not the generated config.
#  Placeholders: {{Name}} → #RRGGBB from the JSON role (append AA for alpha)
#
#  Reload:   makoctl reload
#  DND:      makoctl mode -a do-not-disturb
#            makoctl mode -r do-not-disturb
# ─────────────────────────────────────────────────────────────

# ── global ──────────────────────────────────────────────────
max-history=50
sort=-time
max-visible=5
default-timeout=6000
ignore-timeout=0
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=4
markup=1
actions=1
history=1
layer=overlay
anchor=top-right
group-by=app-name

# ── interactions ────────────────────────────────────────────
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all
on-touch=dismiss

# ── layout ──────────────────────────────────────────────────
width=360
height=140
outer-margin=16
margin=8
padding=12,14
border-size=2
border-radius=8

# ── palette (bgConsole @ ~0.95) ─────────────────────────────
font=Fira Code 11
background-color={{bgConsole}}F2
text-color={{textSecondary}}FF
border-color={{borderIdle}}FF
progress-color=over {{accent}}FF

format=<span foreground="{{textPrimary}}"><b>%s</b></span>\n<span foreground="{{textSecondary}}">%b</span>
text-alignment=left

# ── grouped stack header ────────────────────────────────────
[grouped]
format=<span foreground="{{textPrimary}}"><b>(%g) %s</b></span>\n<span foreground="{{textSecondary}}">%b</span>

[group-index=0]

# ── urgency: low ────────────────────────────────────────────
[urgency=low]
border-color={{borderIdle}}FF
text-color={{textMuted}}FF
background-color={{bgPrimary}}E6
default-timeout=4000
format=<span foreground="{{textSecondary}}"><b>%s</b></span>\n<span foreground="{{textMuted}}">%b</span>

# ── urgency: normal ─────────────────────────────────────────
[urgency=normal]
border-color={{borderIdle}}FF
text-color={{textSecondary}}FF
background-color={{bgConsole}}F2
default-timeout=6000

# ── urgency: critical ───────────────────────────────────────
[urgency=critical]
border-color={{stateCritical}}FF
border-size=3
text-color={{textPrimary}}FF
background-color={{bgElevated}}FF
default-timeout=0
ignore-timeout=1
format=<span foreground="{{stateCritical}}"><b>⚠ %s</b></span>\n<span foreground="{{textSecondary}}">%b</span>
progress-color=over {{stateCritical}}FF

# ── app polish ──────────────────────────────────────────────
[app-name="Astral-Vagabond"]
border-color={{accent}}FF
format=<span foreground="{{textPrimary}}"><b>◆ %s</b></span>\n<span foreground="{{textSecondary}}">%b</span>

[app-name="Quickshell"]
border-color={{accent}}FF
default-timeout=4000
format=<span foreground="{{textPrimary}}"><b>◆ %s</b></span>\n<span foreground="{{textSecondary}}">%b</span>

[app-name="Settings"]
border-color={{accent}}FF
default-timeout=4000

[app-name="Bluetooth"]
border-color={{accent}}FF
default-timeout=4000

[app-name="Network"]
border-color={{accent}}FF
default-timeout=4000

[app-name="Notifications"]
border-color={{accent}}FF
default-timeout=3000

[app-name="Battery"]
border-color={{accent}}FF
default-timeout=4000
format=<span foreground="{{textPrimary}}"><b>◆ %s</b></span>\n<span foreground="{{textSecondary}}">%b</span>

[app-name="Hyprland"]
border-color={{accent}}FF
default-timeout=4000

[app-name="notify-send"]

[app-name="volumectl"]
format=<span foreground="{{textPrimary}}"><b>%s</b></span>
default-timeout=1500

[app-name="brightnessctl"]
format=<span foreground="{{textPrimary}}"><b>%s</b></span>
default-timeout=1500

# ── modes ───────────────────────────────────────────────────
# silent: no on-screen toast; console inbox still records the notification
# dnd:    no toast and console inbox ignores new notifications
[mode=do-not-disturb]
invisible=1

[mode=dnd]
invisible=1

[mode=silent]
invisible=1
