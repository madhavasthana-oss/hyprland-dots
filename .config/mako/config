# ─────────────────────────────────────────────────────────────
#  Astral-Vagabond · mako
#  Rendered by hypr/hyprland/scripts/apply-theme-clients.sh
#  from quickshell/astral-vagabond/colors/active-colors.json
#
#  Edit this template (config.tmpl), not the generated config.
#  Placeholders: {{Name}} → #RRGGBB from the JSON role (append AA for alpha)
#
#  Reload:   makoctl reload
#  DND:      makoctl mode -a do-not-disturb
#            makoctl mode -r do-not-disturb
# ─────────────────────────────────────────────────────────────

# ── global ──────────────────────────────────────────────────
max-history=50
sort=-time
max-visible=5
default-timeout=6000
ignore-timeout=0
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=4
markup=1
actions=1
history=1
layer=overlay
anchor=top-right
group-by=app-name

# ── interactions ────────────────────────────────────────────
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all
on-touch=dismiss

# ── layout ──────────────────────────────────────────────────
width=360
height=140
outer-margin=16
margin=8
padding=12,14
border-size=2
border-radius=8

# ── palette (bgConsole @ ~0.95) ─────────────────────────────
font=Fira Code 11
background-color=#161616F2
text-color=#F0E2EFFF
border-color=#333333FF
progress-color=over #FF1EF3FF

format=<span foreground="#F0E2EF"><b>%s</b></span>\n<span foreground="#F0E2EF">%b</span>
text-alignment=left

# ── grouped stack header ────────────────────────────────────
[grouped]
format=<span foreground="#F0E2EF"><b>(%g) %s</b></span>\n<span foreground="#F0E2EF">%b</span>

[group-index=0]

# ── urgency: low ────────────────────────────────────────────
[urgency=low]
border-color=#333333FF
text-color=#FF1EF3FF
background-color=#121212E6
default-timeout=4000
format=<span foreground="#F0E2EF"><b>%s</b></span>\n<span foreground="#FF1EF3">%b</span>

# ── urgency: normal ─────────────────────────────────────────
[urgency=normal]
border-color=#333333FF
text-color=#F0E2EFFF
background-color=#161616F2
default-timeout=6000

# ── urgency: critical ───────────────────────────────────────
[urgency=critical]
border-color=#E8E8E8FF
border-size=3
text-color=#F0E2EFFF
background-color=#242424FF
default-timeout=0
ignore-timeout=1
format=<span foreground="#E8E8E8"><b>⚠ %s</b></span>\n<span foreground="#F0E2EF">%b</span>
progress-color=over #E8E8E8FF

# ── app polish ──────────────────────────────────────────────
[app-name="Astral-Vagabond"]
border-color=#FF1EF3FF
format=<span foreground="#F0E2EF"><b>◆ %s</b></span>\n<span foreground="#F0E2EF">%b</span>

[app-name="Quickshell"]
border-color=#FF1EF3FF
default-timeout=4000
format=<span foreground="#F0E2EF"><b>◆ %s</b></span>\n<span foreground="#F0E2EF">%b</span>

[app-name="Settings"]
border-color=#FF1EF3FF
default-timeout=4000

[app-name="Wallpaper"]
border-color=#FF1EF3FF
default-timeout=4000

[app-name="Bluetooth"]
border-color=#FF1EF3FF
default-timeout=4000

[app-name="Network"]
border-color=#FF1EF3FF
default-timeout=4000

[app-name="Notifications"]
border-color=#FF1EF3FF
default-timeout=3000

[app-name="Battery"]
border-color=#FF1EF3FF
default-timeout=4000
format=<span foreground="#F0E2EF"><b>◆ %s</b></span>\n<span foreground="#F0E2EF">%b</span>

[app-name="Hyprland"]
border-color=#FF1EF3FF
default-timeout=4000

[app-name="notify-send"]

[app-name="volumectl"]
format=<span foreground="#F0E2EF"><b>%s</b></span>
default-timeout=1500

[app-name="brightnessctl"]
format=<span foreground="#F0E2EF"><b>%s</b></span>
default-timeout=1500

# ── modes ───────────────────────────────────────────────────
# silent: no on-screen toast; console inbox still records the notification
# dnd:    no toast and console inbox ignores new notifications
[mode=do-not-disturb]
invisible=1

[mode=dnd]
invisible=1

[mode=silent]
invisible=1
