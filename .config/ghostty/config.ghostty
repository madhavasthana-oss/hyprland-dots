# Ghostty config — colors and blur/opacity transferred from Kitty
# Kitty sources:
#   ~/.config/kitty/theme.conf      (Ash monochrome colors)
#   ~/.config/kitty/hyde.conf       (background_opacity 0.60)
#   ~/.config/kitty/kitty.conf      (dynamic_background_opacity)
# Hyprland blur is compositor-level; kitty uses window opacity 0.80 in windowrules.conf

font-family = Fira Code
font-feature = +calt
font-feature = +liga
font-feature = +dlig
font-size = 12
window-padding-x = 15
window-padding-y = 15

# background-image = ~/Doomslayer-mod/Pictures/logos/ultraNightmare/ultra-nightmare-240-ascii.png
# background-image-opacity = 0.05
# background-image-position = center
# background-image-fit = contain

# opacity is set to 0.7 instead
background-opacity = 0.7
background-blur = false
background-opacity-cells = false

# Prefer one process; new launches open windows in the existing instance
gtk-single-instance = true

# If monitors show high CPU / iowait with multiple tabs/windows
async-backend = epoll

# custom shaders (paths are relative to this config dir) 
# custom-shader = shaders/cursor_blaze.glsl

theme = Catppuccin Mocha

# optional includes (? = ignore if missing)
config-file = ?~/.config/ghostty/keybinds
