{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "leading_diamond": "<#C8C8C8>┏</>",
      "segments": [
        {
          "foreground": "#C8C8C8",
          "options": {
            "time_format": "01/02/2006 @ 3:04:05 PM MST"
          },
          "style": "diamond",
          "template": "[<#E5E5E5></> {{ .CurrentDate | date .Format }}]",
          "type": "time"
        },
        {
          "foreground": "#C8C8C8",
          "style": "plain",
          "template": "[<#E5E5E5></> {{ .UserName }} :: <#E5E5E5></> {{ .HostName }}]",
          "type": "session"
        },
        {
          "foreground": "#A3A3A3",
          "style": "diamond",
          "template": "[<#E5E5E5></> RAM: {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB]",
          "type": "sysinfo"
        },
        {
          "foreground": "#6B6B6B",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#8A8A8A{{end}}",
            "{{if eq \"Discharging\" .State.String}}#C8C8C8{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "options": {
            "charged_icon": "<#E5E5E5></> ",
            "charging_icon": " ",
            "discharging_icon": "<#A3A3A3></> "
          },
          "style": "plain",
          "template": "[{{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}]",
          "type": "battery"
        },
        {
          "foreground": "#A3A3A3",
          "options": {
            "style": "dallas",
            "threshold": 0
          },
          "style": "diamond",
          "template": "[<#E5E5E5></> {{ .FormattedMs }}s]",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "leading_diamond": "<#C8C8C8>┣</>",
      "segments": [
        {
          "foreground": "#C8C8C8",
          "style": "diamond",
          "template": "[<#E5E5E5></> Subscription: <#A3A3A3>{{ .Name }}</>]",
          "type": "az"
        },
        {
          "foreground": "#C8C8C8",
          "style": "diamond",
          "template": "[<#E5E5E5></> Azure Developer CLI Environment: <#A3A3A3>{{ .DefaultEnvironment }}</> :: <#A3A3A3>{{ .Version }}</>]",
          "type": "azd"
        },
        {
          "foreground": "#C8C8C8",
          "style": "diamond",
          "template": "[<#E5E5E5></> <#A3A3A3>{{ .Profile }}</>{{if .Region}}@<#A3A3A3>{{ .Region }}</>{{ end }}]",
          "type": "aws"
        },
        {
          "foreground": "#C8C8C8",
          "style": "diamond",
          "template": "[{{ if .Error }}{{ .Error }}{{ else }}<#E5E5E5></> <#A3A3A3>{{ .Project }}</> :: <#A3A3A3>{{.Account}}</>{{ end }}]",
          "type": "gcp"
        },
        {
          "foreground": "#737373",
          "style": "diamond",
          "template": "[<#E5E5E5>󱃾</> <#A3A3A3>{{.Context}}</>{{if .Namespace}} :: <#A3A3A3>{{.Namespace}}</>{{end}}]",
          "type": "kubectl"
        },
        {
          "foreground": "#737373",
          "style": "diamond",
          "template": "[{{ if .Error }}{{ .Error }}{{ else }}{{ if .Name }}<#E5E5E5></> {{ .Name }}{{ end }}{{ if .Target }} {{ .Target }}{{ end }}{{ end }}]",
          "type": "project"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "leading_diamond": "<#C8C8C8>┣</>",
      "segments": [
        {
          "foreground": "#C8C8C8",
          "options": {
            "style": "full"
          },
          "style": "diamond",
          "template": "[<#E5E5E5></> <#8A8A8A>{{ .Path }}</>]",
          "type": "path"
        },
        {
          "foreground": "#737373",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "[<#E5E5E5>{{ .UpstreamIcon }} </>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#E5E5E5></> {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} <#6B6B6B></> {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} <#E5E5E5></> {{ .StashCount }}{{ end }}]",
          "type": "git"
        },
        {
          "foreground": "#A3A3A3",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "display_default": false
          },
          "style": "diamond",
          "template": "[<#E5E5E5></> {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}<#8A8A8A>{{ .Venv }}</>{{ if .Full }} | {{ end }}{{ end }}{{ if .Full }}{{ .Full }}{{ end }}{{ end }}]",
          "type": "python"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#C8C8C8",
          "style": "plain",
          "template": "└─",
          "type": "text"
        },
        {
          "style": "diamond",
          "template": "<#A3A3A3>[#]</>",
          "type": "root"
        },
        {
          "foreground": "#8A8A8A",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#6B6B6B{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": "[{{ if gt .Code 0 }}</> exit {{ .Code }}{{ else }} nominal{{ end }}] ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "secondary_prompt": {
    "background": "transparent",
    "template": " "
  },
  "valid_line": {
    "background": "transparent",
    "template": "> "
  },
  "error_line": {
    "background": "transparent",
    "template": "<#6B6B6B></> "
  },
  "version": 4
}
